---
// src/components/Destaques.astro
// Seção de Destaques do Catálogo com Prateleira de Vidro + GSAP Timeline
---

<section
  id="destaques"
  class="relative bg-[#0B0B0E] overflow-hidden flex flex-col items-center justify-center py-12 md:py-28 px-4"
>

  {/* ── Título da Seção (oculto — GSAP revela) ── */}
  <div class="secao-titulo text-center mb-8 md:mb-12 opacity-0 -translate-y-10 z-10 relative">
    <span class="text-xs font-semibold text-[#FACC15] uppercase tracking-[0.25em] block mb-3">
      Direto da Loja
    </span>
    <h2 class="text-white text-3xl sm:text-4xl md:text-5xl font-light tracking-tight leading-tight">
      Especialidades <span class="font-bold text-[#FACC15]">da Casa</span>
    </h2>
    <p class="text-gray-400 text-base mt-4 max-w-xl mx-auto leading-relaxed">
      Peças e acessórios selecionados com a qualidade que o seu aparelho merece.
    </p>
  </div>

  {/* ── Wrapper do Palco ── */}
  <div class="relative w-full max-w-6xl mx-auto flex flex-col items-center justify-center">

    {/* ── Prateleira de Vidro (Linha global para Desktop) ── */}
    <div
      class="prateleira hidden md:block absolute left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full z-0"
      style="
        background: linear-gradient(to right, transparent, rgba(234,179,8,0.6), transparent);
        box-shadow: 0 0 30px 4px rgba(234,179,8,0.25), 0 0 60px 12px rgba(234,179,8,0.08);
        top: 340px; /* Alinhado com o novo fundo estendido das imagens */
      "
    ></div>

    {/* ── Grid de 3 Produtos ── */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-10 md:gap-y-20 relative z-10 w-full">

      {/* Card 1: Bateria */}
      <div class="flex flex-col items-center text-center">

        {/* Imagem Container Fixo (alinha base de todos os itens) */}
        <div class="h-[200px] sm:h-[280px] md:h-[340px] w-full flex items-end justify-center relative mb-3 md:mb-8">
          <div class="item-glow opacity-0 absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-3 bg-amber-500/20 blur-xl rounded-full"></div>
          
          {/* Prateleira Mobile (Linha individual) */}
          <div class="md:hidden absolute bottom-0 left-1/2 -translate-x-1/2 h-[1px] w-3/4 bg-gradient-to-r from-transparent via-amber-500/50 to-transparent"></div>
          
          <img
            src="/bateria.webp"
            alt="Bateria de Alta Duração"
            class="item-flutuante item-flutuante-1 w-80 sm:w-96 object-contain relative opacity-0 drop-shadow-[0_15px_35px_rgba(234,179,8,0.25)]"
          />
        </div>

        {/* Texto colado sob a imagem */}
        <div class="item-texto opacity-0 space-y-2">
          <h3 class="text-white font-bold text-xl tracking-tight">Baterias Premium</h3>
          <p class="text-gray-400 text-sm leading-relaxed max-w-[260px] mx-auto">
            Alta capacidade e ciclos certificados. Devolva a autonomia original.
          </p>
          <a
            href="https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20uma%20bateria%20premium"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-3 px-5 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-[#FACC15]/50 text-[#FACC15] text-xs font-semibold transition-all active:scale-95"
          >
            Consultar Valor
          </a>
        </div>
      </div>

      {/* Card 2: SSD */}
      <div class="flex flex-col items-center text-center">
        <div class="h-[200px] sm:h-[280px] md:h-[340px] w-full flex items-end justify-center relative mb-3 md:mb-8">
          <div class="item-glow opacity-0 absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-3 bg-amber-500/20 blur-xl rounded-full"></div>
          <div class="md:hidden absolute bottom-0 left-1/2 -translate-x-1/2 h-[1px] w-3/4 bg-gradient-to-r from-transparent via-amber-500/50 to-transparent"></div>
          <img
            src="/ssd.webp"
            alt="SSD de Alta Velocidade"
            class="item-flutuante item-flutuante-2 w-80 sm:w-96 object-contain relative opacity-0 drop-shadow-[0_15px_35px_rgba(234,179,8,0.25)]"
          />
        </div>

        <div class="item-texto opacity-0 space-y-2">
          <h3 class="text-white font-bold text-xl tracking-tight">SSDs Velocidade Máxima</h3>
          <p class="text-gray-400 text-sm leading-relaxed max-w-[260px] mx-auto">
            Transforme seu notebook lento em uma máquina veloz. Clonagem inclusa.
          </p>
          <a
            href="https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20saber%20sobre%20SSDs"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-3 px-5 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-[#FACC15]/50 text-[#FACC15] text-xs font-semibold transition-all active:scale-95"
          >
            Consultar Valor
          </a>
        </div>
      </div>

      {/* Card 3: Película */}
      <div class="flex flex-col items-center text-center">
        <div class="h-[200px] sm:h-[280px] md:h-[340px] w-full flex items-end justify-center relative mb-3 md:mb-8">
          <div class="item-glow opacity-0 absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-3 bg-amber-500/20 blur-xl rounded-full"></div>
          <div class="md:hidden absolute bottom-0 left-1/2 -translate-x-1/2 h-[1px] w-3/4 bg-gradient-to-r from-transparent via-amber-500/50 to-transparent"></div>
          <img
            src="/pelicula.webp"
            alt="Película Protetora 3D"
            class="item-flutuante item-flutuante-3 w-80 sm:w-96 object-contain relative opacity-0 drop-shadow-[0_15px_35px_rgba(234,179,8,0.25)]"
          />
        </div>

        <div class="item-texto opacity-0 space-y-2">
          <h3 class="text-white font-bold text-xl tracking-tight">Películas 3D Cerâmica</h3>
          <p class="text-gray-400 text-sm leading-relaxed max-w-[260px] mx-auto">
            Cobertura total e aplicação profissional. Sem bolhas e com garantia.
          </p>
          <a
            href="https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20saber%20sobre%20pel%C3%ADculas"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-3 px-5 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-[#FACC15]/50 text-[#FACC15] text-xs font-semibold transition-all active:scale-95"
          >
            Consultar Valor
          </a>
        </div>
      </div>

    </div>
  </div>

</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section      = document.getElementById("destaques");
  const titulo       = document.querySelector(".secao-titulo");
  const prateleira   = document.querySelector(".prateleira");
  const itensImg     = document.querySelectorAll(".item-flutuante");
  const itensTxt     = document.querySelectorAll(".item-texto");
  const itensGlow    = document.querySelectorAll(".item-glow");

  if (section && titulo && prateleira && itensImg.length && itensTxt.length) {

    // ── Estado inicial ─────────────────────────────────────────────────────────
    gsap.set(itensImg, { y: -60, opacity: 0 }); // Vem DE CIMA (negativo) para não furar a prateleira por baixo
    gsap.set(itensTxt, { y: 15, opacity: 0 });

    let levitationTweens: gsap.core.Tween[] = [];

    // ── Timeline com Scrub (Animação atrelada ao Scroll) ─────────────────────
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 85%",    // Inicia quando o topo da seção chega a 85% da tela
        end: "top 35%",      // Termina quando chega a 35% da tela
        scrub: 1,            // 1 segundo de suavização para acompanhar o scroll (vai e volta)
        onLeave: iniciarLevitacao,     // Quando terminar de descer, inicia levitação
        onEnterBack: pararLevitacao,   // Se o usuário voltar a subir, para a levitação
      }
    });

    tl.to(titulo, {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "none",
    });

    tl.to(prateleira, {
      width: "80%",
      duration: 1,
      ease: "none",
    }, "-=0.5");

    tl.to(itensImg, {
      y: 0,
      opacity: 1,
      duration: 1.5,
      ease: "none",
      stagger: 0.3,
    }, "-=0.8");

    tl.to(itensGlow, {
      opacity: 1,
      duration: 1.5,
      ease: "none",
      stagger: 0.3,
    }, "<"); // Anima as luzes exatamente ao mesmo tempo que as imagens

    tl.to(itensTxt, {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "none",
      stagger: 0.2,
    }, "-=1.2");

    // ── Funções de Levitação ─────────────────────────────────────────────────
    function iniciarLevitacao() {
      const img1 = document.querySelector(".item-flutuante-1");
      const img2 = document.querySelector(".item-flutuante-2");
      const img3 = document.querySelector(".item-flutuante-3");

      if (img1) {
        levitationTweens.push(gsap.to(img1, { y: -20, duration: 2.5, ease: "sine.inOut", yoyo: true, repeat: -1 }));
      }
      if (img2) {
        levitationTweens.push(gsap.to(img2, { y: -20, duration: 2.5, ease: "sine.inOut", yoyo: true, repeat: -1, delay: -0.8 }));
      }
      if (img3) {
        levitationTweens.push(gsap.to(img3, { y: -20, duration: 2.5, ease: "sine.inOut", yoyo: true, repeat: -1, delay: -1.6 }));
      }
    }

    function pararLevitacao() {
      // Mata a animação infinita para o ScrollTrigger assumir o controle do 'y' novamente
      levitationTweens.forEach(t => t.kill());
      levitationTweens = [];
      // Retorna as imagens para a base (y=0) para o scrub puxá-las de volta corretamente
      gsap.to(itensImg, { y: 0, duration: 0.3, ease: "power2.out" });
    }
  }
</script>
