---
// src/components/CatalogoEstendido.astro
// Catálogo Completo — Slim Accordion com Dark Mode corporativo de luxo.
// Animação via Vanilla JS (max-height + opacity). Zero frameworks client-side.

const categorias = [
  {
    id: "reparos-placa",
    titulo: "Reparos Avançados em Placa",
    descricao:
      "Micro-soldagem, desoxidação após contato com líquidos, troca de conectores de carga e recuperação de curtos. Cada ponto de solda tratado com estação de retrabalho profissional e lupa de ampliação.",
    cta: "Orçar Reparo em Placa",
    whatsapp:
      "https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20reparo%20em%20placa",
    numero: "01",
  },
  {
    id: "manutencao-software",
    titulo: "Manutenção de Software",
    descricao:
      "Atualização de sistema, recuperação de loop infinito, remoção de malwares e backup de dados em smartphones. Diagnóstico completo antes de qualquer intervenção no sistema.",
    cta: "Orçar Manutenção de Software",
    whatsapp:
      "https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20manuten%C3%A7%C3%A3o%20de%20software",
    numero: "02",
  },
  {
    id: "informatica-prevencao",
    titulo: "Informática e Prevenção",
    descricao:
      "Limpeza térmica preventiva de notebooks, instalação de sistemas operacionais e pacotes Office. Um notebook limpo por dentro roda até 40% mais rápido e tem vida útil drasticamente aumentada.",
    cta: "Orçar Limpeza e Instalação",
    whatsapp:
      "https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20limpeza%20e%20instala%C3%A7%C3%A3o",
    numero: "03",
  },
  {
    id: "acessorios-varejo",
    titulo: "Acessórios de Varejo",
    descricao:
      "Fontes turbo, cabos blindados, capas anti-impacto, roteadores e repetidores Wi-Fi das melhores marcas. Todos os itens testados e com garantia de procedência.",
    cta: "Ver Disponibilidade de Acessórios",
    whatsapp:
      "https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20saber%20a%20disponibilidade%20de%20acess%C3%B3rios",
    numero: "04",
  },
];
---

<section
  id="catalogo-estendido"
  class="relative bg-[#0B0B0E] py-24 md:py-32 overflow-hidden"
>
  <!-- Linha decorativa de topo -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <div class="max-w-4xl mx-auto px-6">

    <!-- Cabeçalho -->
    <div class="mb-16">
      <span class="text-xs font-semibold text-[#FACC15] uppercase tracking-[0.3em] block mb-4">
        Catálogo Completo
      </span>
      <h2 class="text-white text-3xl sm:text-4xl font-light tracking-tight leading-snug">
        Soluções definitivas <br />
        <span class="font-bold">para o seu aparelho.</span>
      </h2>
    </div>

    <!-- Acordeão -->
    <div class="accordion-root" role="list">
      {categorias.map((cat) => (
        <div
          class="accordion-item border-b border-white/[0.07]"
          role="listitem"
          data-accordion-item
        >
          <!-- Trigger -->
          <button
            class="accordion-trigger group flex justify-between items-center w-full py-7 text-left gap-6 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-yellow-500/50 rounded"
            aria-expanded="false"
            aria-controls={`panel-${cat.id}`}
            id={`trigger-${cat.id}`}
            data-accordion-trigger
          >
            <div class="flex items-baseline gap-5">
              <span class="text-[10px] font-mono text-white/20 group-hover:text-[#FACC15]/50 transition-colors duration-300 select-none shrink-0">
                {cat.numero}
              </span>
              <span class="accordion-title text-2xl sm:text-3xl font-light text-gray-400 group-hover:text-white transition-colors duration-300 leading-tight">
                {cat.titulo}
              </span>
            </div>

            <!-- Ícone + / − -->
            <span
              class="accordion-icon shrink-0 relative flex items-center justify-center w-8 h-8 rounded-full border border-white/10 group-hover:border-white/25 transition-all duration-300"
              aria-hidden="true"
            >
              <span class="absolute block w-3 h-px bg-gray-500 group-hover:bg-white transition-colors duration-300"></span>
              <span class="absolute block w-px h-3 bg-gray-500 group-hover:bg-white transition-all duration-300 accordion-icon-vertical"></span>
            </span>
          </button>

          <!-- Painel -->
          <div
            id={`panel-${cat.id}`}
            class="accordion-panel overflow-hidden"
            style="max-height: 0; opacity: 0;"
            role="region"
            aria-labelledby={`trigger-${cat.id}`}
            data-accordion-panel
          >
            <div class="pt-1 pb-10 pl-10">
              <div class="w-8 h-px bg-[#FACC15]/40 mb-6"></div>
              <p class="text-lg text-gray-400 leading-relaxed max-w-2xl">
                {cat.descricao}
              </p>
              <a
                href={cat.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center min-h-[48px] px-6 mt-8 rounded-full bg-white/5 border border-white/10 text-sm font-semibold text-[#FACC15] tracking-wider uppercase hover:bg-white/10 transition-all duration-200 group/cta"
              >
                <span>{cat.cta}</span>
                <svg class="w-4 h-4 ml-2 transform group-hover/cta:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .accordion-icon-vertical {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity   0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accordion-item.is-open .accordion-icon-vertical {
    transform: rotate(90deg);
    opacity: 0;
  }

  .accordion-item.is-open .accordion-title {
    color: white;
  }

  .accordion-item.is-open .accordion-icon {
    border-color: rgba(255, 255, 255, 0.25);
  }

  .accordion-panel {
    transition:
      max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity    0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  function initAccordion() {
    const items    = document.querySelectorAll<HTMLElement>("[data-accordion-item]");
    const triggers = document.querySelectorAll<HTMLButtonElement>("[data-accordion-trigger]");
    const panels   = document.querySelectorAll<HTMLElement>("[data-accordion-panel]");

    function closeAll(excludeIndex?: number) {
      items.forEach((item, i) => {
        if (i === excludeIndex) return;
        item.classList.remove("is-open");
        const trigger = item.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
        const panel   = item.querySelector<HTMLElement>("[data-accordion-panel]");
        if (trigger) trigger.setAttribute("aria-expanded", "false");
        if (panel) {
          panel.style.maxHeight = "0";
          panel.style.opacity   = "0";
        }
      });
    }

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        const item   = items[index];
        const panel  = panels[index];
        const isOpen = item.classList.contains("is-open");

        closeAll(isOpen ? undefined : index);

        if (!isOpen) {
          item.classList.add("is-open");
          trigger.setAttribute("aria-expanded", "true");
          panel.style.maxHeight = panel.scrollHeight + "px";
          panel.style.opacity   = "1";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initAccordion);
  document.addEventListener("DOMContentLoaded", initAccordion);
</script>
