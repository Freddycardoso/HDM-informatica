---
// src/components/Depoimentos.astro
// Seção de Prova Social — Marquee Infinito com Glassmorphism
// Animação puramente CSS (sem JS), loop perfeito com dois sets idênticos.

const depoimentos = [
  {
    nome: "Jorge Dias de Oliveira Jr.",
    iniciais: "JD",
    cor: "from-amber-600 to-yellow-500",
    texto: "Excelente loja. Recomendo, suporte rápido e especializado para meu notebook.",
  },
  {
    nome: "Diogenes Silveira",
    iniciais: "DS",
    cor: "from-slate-600 to-slate-400",
    texto: "Ótima loja, sempre fazendo o possível para atender os clientes da melhor forma possível! Recomendo.",
  },
  {
    nome: "Daniel Mattar",
    iniciais: "DM",
    cor: "from-blue-700 to-blue-500",
    texto: null,
  },
  {
    nome: "Livia Silveira",
    iniciais: "LS",
    cor: "from-rose-700 to-rose-400",
    texto: null,
  },
  {
    nome: "Brener Vinicius",
    iniciais: "BV",
    cor: "from-emerald-700 to-emerald-500",
    texto: null,
  },
];
---

<section
  id="depoimentos"
  class="relative bg-[#0B0B0E] py-24 overflow-hidden"
>
  <!-- Linha decorativa de topo -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <!-- Cabeçalho -->
  <div class="text-center mb-16 px-4">
    <h2 class="text-xs font-semibold text-[#FACC15] uppercase tracking-[0.3em] mb-4">
      Aprovado em Passos — MG
    </h2>
    <h3 class="text-4xl sm:text-5xl font-light text-white">
      O que nossos <span class="font-bold">clientes dizem</span>
    </h3>
  </div>

  <!-- Marquee Wrapper -->
  <div class="relative w-full overflow-hidden">

    <!-- Gradiente fade esquerda -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-32 z-10
                bg-gradient-to-r from-[#0B0B0E] to-transparent"></div>

    <!-- Gradiente fade direita -->
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-32 z-10
                bg-gradient-to-l from-[#0B0B0E] to-transparent"></div>

    <!-- Track: dois sets idênticos para loop perfeito -->
    <div class="marquee-track flex gap-6 py-4 w-max">

      <!-- SET 1 -->
      {depoimentos.map((d) => (
        <div class="card-review w-80 flex-shrink-0 bg-white/[0.04] backdrop-blur-sm
                    border border-white/[0.08] rounded-2xl p-6
                    hover:bg-white/[0.07] hover:border-white/15
                    transition-colors duration-300">

          <!-- Header: Avatar + Nome -->
          <div class="flex items-center gap-3 mb-4">
            <div class={`w-10 h-10 rounded-full bg-gradient-to-br ${d.cor}
                         flex items-center justify-center
                         text-white text-xs font-bold select-none shrink-0`}>
              {d.iniciais}
            </div>
            <div>
              <p class="text-white text-sm font-semibold leading-tight">{d.nome}</p>
              <p class="text-white/30 text-[10px] mt-0.5">Google Reviews</p>
            </div>
          </div>

          <!-- Estrelas -->
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg class="w-4 h-4 text-[#FACC15]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Texto do depoimento -->
          {d.texto && (
            <p class="text-gray-400 text-sm mt-3 leading-relaxed">
              "{d.texto}"
            </p>
          )}
        </div>
      ))}

      <!-- SET 2 (idêntico — necessário para o loop sem salto) -->
      {depoimentos.map((d) => (
        <div class="card-review w-80 flex-shrink-0 bg-white/[0.04] backdrop-blur-sm
                    border border-white/[0.08] rounded-2xl p-6
                    hover:bg-white/[0.07] hover:border-white/15
                    transition-colors duration-300">

          <div class="flex items-center gap-3 mb-4">
            <div class={`w-10 h-10 rounded-full bg-gradient-to-br ${d.cor}
                         flex items-center justify-center
                         text-white text-xs font-bold select-none shrink-0`}>
              {d.iniciais}
            </div>
            <div>
              <p class="text-white text-sm font-semibold leading-tight">{d.nome}</p>
              <p class="text-white/30 text-[10px] mt-0.5">Google Reviews</p>
            </div>
          </div>

          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg class="w-4 h-4 text-[#FACC15]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          {d.texto && (
            <p class="text-gray-400 text-sm mt-3 leading-relaxed">
              "{d.texto}"
            </p>
          )}
        </div>
      ))}

    </div>
  </div>

  <!-- Rodapé da Seção -->
  <div class="text-center mt-12 px-4">
    <p class="text-white/25 text-xs uppercase tracking-widest">
      Avaliações verificadas — Google Meu Negócio
    </p>
  </div>

</section>

<style>
  /* ── Keyframe do Marquee ─────────────────────────────────────────────────── */
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* move exatamente 1 set (50% do total) */
  }

  .marquee-track {
    animation: marquee 60s linear infinite;
    will-change: transform; /* ativa aceleração por hardware */
  }

  /* Pausa ao passar o mouse — melhor UX para quem quiser ler */
  .marquee-track:hover {
    animation-play-state: paused;
  }

  /* Reduz velocidade em preferência de movimento reduzido */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation-duration: 120s;
    }
  }
</style>
