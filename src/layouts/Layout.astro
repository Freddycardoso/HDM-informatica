---
/**
 * @file src/layouts/Layout.astro
 * Layout Master da HDM Infocell - Assistência Técnica & Acessórios.
 * 
 * Responsabilidades:
 * 1. SEO Técnico Centralizado (Meta tags, Open Graph, Twitter Cards, Canonical URL).
 * 2. Schema.org LocalBusiness (JSON-LD nativo) para E-E-A-T e autoridade em Passos - MG.
 * 3. Design System Dark Mesh: Fundo #0B0B0E com vazamentos de luz (glows) em blur-3xl amarelo/laranja.
 * 4. Header & Top Bar Contract de 3 zonas sem poluição visual.
 * 5. Zero-JS por padrão para LCP ultrarrápido.
 */

import '../index.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "HDM Informática | Conserto de Celular e Notebook em Passos - MG",
  description = "Conserto, troca de tela, bateria e reparo de placa de celulares e notebooks em Passos - MG. Orçamento imediato via WhatsApp com técnicos qualificados.",
  canonicalUrl = Astro.url ? Astro.url.href : "https://hdminfocell.com.br",
  ogImage = "/og-image.jpg",
} = Astro.props;

// Schema.org estruturado em conformidade com Google Search Central para negócios locais
const schemaData = {
  "@context": "https://schema.org",
  "@type": "MobilePhoneStore",
  "@id": "https://hdminfocell.com.br/#localbusiness",
  "name": "HDM Informática e Celulares",
  "legalName": "HDM Informática e Celulares",
  "image": ogImage,
  "description": "Assistência técnica de celulares, smartphones, computadores, notebooks e venda de acessórios premium em Passos - MG.",
  "url": "https://hdminfocell.com.br",
  "telephone": "+5535999820832",
  "priceRange": "$$",
  "currenciesAccepted": "BRL",
  "paymentAccepted": "Cash, Credit Card, Debit Card, Pix",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Tenente Vasconcelos, 273, Centro",
    "addressLocality": "Passos",
    "addressRegion": "MG",
    "postalCode": "37900-073",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -20.7188,
    "longitude": -46.6111
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Passos",
      "sameAs": "https://pt.wikipedia.org/wiki/Passos_(Minas_Gerais)"
    }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:30",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
