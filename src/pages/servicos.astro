---
/**
 * @file src/pages/servicos.astro
 * Página de Serviços e Assistência Técnica Especializada da HDM Infocell.
 * 
 * Funcionalidade:
 * - Hub de qualificação com mensagens WhatsApp pré-formatadas para cada tipo de reparo.
 * - Glassmorphism, Dark Mesh Grid e botões com alvos táteis mínimos de 48px.
 */

import Layout from '../layouts/Layout.astro';

const servicos = [
  {
    titulo: "Troca de Tela & Display",
    descricao: "Recuperação total para telas trincadas, touch travado, tela preta ou listras coloridas. Peças originais e premium para todas as principais marcas.",
    mensagem: "Olá, preciso de um orçamento para troca de tela",
    icone: "smartphone",
    destaque: "Mais Solicitado",
    detalhes: ["iPhone, Samsung, Xiaomi, Motorola", "Aparelho pronto com agilidade", "90 dias de garantia com nota"]
  },
  {
    titulo: "Troca de Bateria",
    descricao: "Bateria viciada, descarregando em poucas horas ou estufada? Substituição segura por baterias de alta capacidade e durabilidade garantida.",
    mensagem: "Olá, preciso de um orçamento para troca de bateria",
    icone: "battery",
    destaque: "Essencial",
    detalhes: ["Saúde da bateria restaurada", "Sem superaquecimento", "Calibração de carga inclusa"]
  },
  {
    titulo: "Reparo em Placa Lógica",
    descricao: "Celular não liga, sofreu queda grave ou parou de dar sinal? Laboratório equipado com microscópio trinocular para micro-soldagem e recuperação de circuitos.",
    mensagem: "Olá, preciso de um orçamento para reparo em placa",
    icone: "cpu",
    destaque: "Avançado",
    detalhes: ["Recuperação de trilhas e componentes", "Reparo de PMIC e setor de áudio", "Diagnóstico avançado"]
  },
  {
    titulo: "Manutenção de Notebooks",
    descricao: "Limpeza interna profunda, substituição de pasta térmica com prata, upgrade para SSD NVMe, aumento de memória RAM e formatação com backup seguro.",
    mensagem: "Olá, preciso de um orçamento para manutenção de notebook",
    icone: "laptop",
    destaque: "Produtividade",
    detalhes: ["Dell, Lenovo, Acer, Asus, Apple", "Fim de lentidões e travamentos", "Troca de teclado e carcaça"]
  },
  {
    titulo: "Desoxidação (Aparelho Molhado)",
    descricao: "Caiu na água ou sofreu umidade? Banho químico ultrassônico imediato para estancar a corrosão das trilhas e salvar sua placa e arquivos.",
    mensagem: "Olá, meu aparelho molhou e preciso de socorro imediato para desoxidação",
    icone: "droplet",
    destaque: "Urgência",
    detalhes: ["Secagem química especializada", "Inspeção contra curto-circuito", "Taxa alta de recuperação"]
  },
  {
    titulo: "Conector de Carga & Câmeras",
    descricao: "Cabo com mau contato para carregar, microfone mudo ou lentes de câmera riscadas e embaçadas? Substituição cirúrgica com peças testadas.",
    mensagem: "Olá, preciso de reparo no conector de carga / câmera do meu aparelho",
    icone: "plug",
    destaque: "Rápido",
    detalhes: ["Conectores Type-C e Lightning", "Câmeras traseiras e frontais", "Testes de corrente e voltagem"]
  }
];
---

<Layout 
  title="Serviços de Assistência Técnica em Celular e PC | HDM Infocell Passos - MG"
  description="Conserto de celulares, troca de tela, troca de bateria, micro-soldagem em placa e manutenção de notebooks em Passos - MG. Orçamento direto via WhatsApp."
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Cabeçalho */}
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-amber-400 uppercase tracking-wider mb-2">
        <a href="/" class="hover:underline text-gray-400">Início</a>
        <span class="text-gray-600">/</span>
        <span>Assistência Especializada</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Serviços de Assistência Técnica
      </h1>
      <p class="text-base sm:text-lg text-gray-300 mt-4 leading-relaxed">
        Selecione o reparo desejado para abrir o WhatsApp com seu orçamento já pré-configurado. Nossos técnicos atendem você de forma ágil e personalizada.
      </p>
    </div>

    {/* Grid Bento de Serviços */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicos.map((servico) => (
        <div class="rounded-3xl bg-white/[0.04] backdrop-blur-md border border-white/10 p-7 flex flex-col justify-between hover:border-amber-500/40 hover:bg-white/[0.06] transition-all group">
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-semibold text-[#FACC15] bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
                {servico.destaque}
              </span>
              <span class="text-xs text-gray-400">Passos - MG</span>
            </div>

            <h2 class="font-display text-xl font-bold text-white mb-2 group-hover:text-[#FACC15] transition-colors">
              {servico.titulo}
            </h2>

            <p class="text-sm text-gray-300 mb-6 leading-relaxed">
              {servico.descricao}
            </p>

            <ul class="space-y-2 mb-8 text-xs text-gray-400">
              {servico.detalhes.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FACC15]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Botão com WhatsApp URL-encoded */}
          <a
            href={`https://wa.me/5535999820832?text=${encodeURIComponent(servico.mensagem)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[48px] px-5 py-3 rounded-xl bg-[#FACC15] text-black font-semibold text-sm hover:bg-yellow-400 active:scale-[0.98] transition-all flex items-center justify-between shadow-md shadow-yellow-500/10"
            aria-label={`Solicitar orçamento para ${servico.titulo} no WhatsApp`}
          >
            <span>Solicitar Orçamento</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    {/* Seção de Contato Customizado caso o problema não esteja na lista */}
    <div class="mt-16 p-8 rounded-3xl bg-white/[0.02] border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="font-display text-xl font-bold text-white">Não encontrou o que seu aparelho tem?</h3>
        <p class="text-sm text-gray-400 mt-1">Fale diretamente com nossa bancada técnica para um diagnóstico sem compromisso.</p>
      </div>
      <a
        href="https://wa.me/5535999820832?text=Ol%C3%A1%2C%20tenho%20um%20problema%20espec%C3%ADfico%20no%20meu%20aparelho%20e%20gostaria%20de%20ajuda"
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[48px] px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/15 transition-all flex items-center gap-2 whitespace-nowrap"
      >
        <span>Explicar meu caso no WhatsApp</span>
        <span>→</span>
      </a>
    </div>

  </div>
</Layout>
