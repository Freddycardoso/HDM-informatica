---
/**
 * @file src/pages/index.astro
 * Página Principal (Home) da HDM Infocell.
 * 
 * Engenharia & Arquitetura:
 * - Renderizado com Layout.astro (SSG Zero-JS).
 * - Hero com UVP explícita: "Especialistas em conserto de celulares, notebooks e venda de acessórios em Passos - MG".
 * - 2 CTAs Primários: Direcionando para /servicos e /produtos.
 * - Bento Grid assimétrico flutuante com Glassmorphism (bg-white/5, backdrop-blur-md, border-white/10).
 * - Botões com URLs diretas do WhatsApp (wa.me/5535999820832?text=...) devidamente URL-encoded.
 * - Touch targets >= 48px com responsividade mobile-first.
 */

import Layout from '../layouts/Layout.astro';
import TrocaDeTelaAnimada from '../components/TrocaDeTelaAnimada.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import Destaques from '../components/Destaques.astro';
import CatalogoEstendido from '../components/CatalogoEstendido.astro';
import Depoimentos from '../components/Depoimentos.astro';
import QuemSomos from '../components/QuemSomos.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout 
  title="HDM Informática"
  description="Especialistas em conserto de celulares, notebooks e venda de acessórios em Passos - MG. Troca de tela, bateria, reparo em placa e suporte com garantia."
>
  {/* ========================================================
      HERO CINEMATOGRAFICA (GSAP ScrollTrigger)
     ======================================================== */}
  <HeroCinematic />

  {/* ========================================================
      SEÇÃO ANIMADA GSAP: Troca de Tela Original
     ======================================================== */}
  <TrocaDeTelaAnimada />

  {/* ========================================================
      DESTAQUES DO CATÁLOGO: Prateleira + Levitação
     ======================================================== */}
  <Destaques />

  {/* ========================================================
      CATÁLOGO ESTENDIDO: Slim Accordion de Serviços
     ======================================================== */}
  <CatalogoEstendido />

  {/* ========================================================
      PROVA SOCIAL: Marquee de Depoimentos
     ======================================================== */}
  <Depoimentos />

  {/* ========================================================
      QUEM SOMOS: Credibilidade e E-E-A-T
     ======================================================== */}
  <QuemSomos />

  {/* ========================================================
      POR QUE A HDM INFOCELL? (E-E-A-T & Confiança Local)
     ======================================================== */}
  <section class="pt-16 pb-24 md:pb-32 border-t border-white/5 bg-[#09090C]/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-semibold text-[#FACC15] uppercase tracking-wider">Compromisso Técnico</span>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mt-1">
          Por que confiar seu aparelho à HDM Infocell?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5">
          <span class="text-2xl font-bold text-[#FACC15] font-mono">01.</span>
          <h3 class="text-lg font-bold text-white mt-3 mb-2">Diagnóstico Transparente</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Identificamos a causa real do defeito antes de qualquer intervenção. Sem troca desnecessária de peças ou orçamentos surpresa.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5">
          <span class="text-2xl font-bold text-[#FACC15] font-mono">02.</span>
          <h3 class="text-lg font-bold text-white mt-3 mb-2">Peças com Procedência</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Utilizamos displays e baterias de altíssimo padrão, mantendo a sensibilidade do toque, brilho fiel e segurança de carga do aparelho.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5">
          <span class="text-2xl font-bold text-[#FACC15] font-mono">03.</span>
          <h3 class="text-lg font-bold text-white mt-3 mb-2">Garantia Formal de 90 Dias</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Todos os reparos contam com certificado de garantia legal. Atendimento direto e suporte pós-serviço em nossa loja em Passos - MG.
          </p>
        </div>

      </div>

      {/* Banner de Chamada Final */}
      <div class="mt-16 rounded-3xl p-8 sm:p-10 bg-gradient-to-r from-amber-500/10 via-yellow-500/5 to-transparent border border-amber-500/20 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <h3 class="font-display text-2xl font-bold text-white">
            Precisa de um orçamento urgente para o seu celular ou notebook?
          </h3>
          <p class="text-sm text-gray-400">
            Envie uma foto do defeito ou descreva o problema. Nosso técnico responde em minutos.
          </p>
        </div>

        <a
          href="https://wa.me/5535999820832?text=Ol%C3%A1%2C%20preciso%20de%20um%20or%C3%A7amento%20urgente"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[48px] px-8 py-3.5 rounded-xl bg-[#FACC15] text-black font-bold text-base hover:bg-yellow-400 active:scale-[0.98] transition-all flex items-center gap-2 whitespace-nowrap shadow-xl shadow-yellow-500/20"
          aria-label="Solicitar orçamento urgente pelo WhatsApp"
        >
          <span>Falar no WhatsApp</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  {/* ========================================================
      DÚVIDAS COMUNS (FAQ)
     ======================================================== */}
  <FAQ />
</Layout>

