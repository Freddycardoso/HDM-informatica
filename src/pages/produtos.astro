---
/**
 * @file src/pages/produtos.astro
 * Vitrine de Acessórios e Periféricos da HDM Infocell.
 * 
 * Funcionalidade:
 * - Hub de captação de varejo com mensagens WhatsApp pré-formatadas para consulta de disponibilidade.
 * - Estética Bento Grid + Glassmorphism com touch targets de 48px.
 */

import Layout from '../layouts/Layout.astro';

const categorias = [
  {
    titulo: "Cabos e Carregadores",
    descricao: "Linha completa de carregadores turbo rápidos, fontes GaN de 20W a 65W, cabos trançados de alta resistência Tipo-C, Lightning e Micro-USB com certificação.",
    mensagem: "Olá, gostaria de saber os modelos de cabos e carregadores disponíveis",
    destaque: "Mais Vendido",
    itens: ["Fontes Turbo 20W/30W/65W", "Cabos reforçados em nylon", "Compatíveis com iPhone e Android"]
  },
  {
    titulo: "Películas e Capinhas",
    descricao: "Proteção máxima contra quedas e riscos. Películas cerâmicas flexíveis, vidro temperado 3D, privacidade e fosca gamer. Capas anti-impacto militares e silicone aveludado.",
    mensagem: "Olá, gostaria de saber as opções de películas e capinhas para o meu aparelho",
    destaque: "Proteção Total",
    itens: ["Películas com aplicação profissional", "Capas anti-queda com borda elevada", "Opções com suporte MagSafe"]
  },
  {
    titulo: "Periféricos",
    descricao: "Acessórios para potencializar seu computador ou notebook: mouses ergonômicos e gamers, teclados, suportes articulados de alumínio, adaptadores USB-C e hubs multifuncionais.",
    mensagem: "Olá, gostaria de saber os modelos de periféricos disponíveis",
    destaque: "Informática",
    itens: ["Mouses ópticos e sem fio", "Hubs USB-C para HDMI/Rede", "Bases refrigeradas para notebook"]
  },
  {
    titulo: "Fones de Ouvido & Caixas de Som",
    descricao: "Fones Bluetooth TWS com cancelamento de ruído, fones auriculares clássicos com microfone nítido e caixas de som portáteis com bateria de longa duração.",
    mensagem: "Olá, gostaria de saber os modelos de fones de ouvido e caixas de som disponíveis",
    destaque: "Áudio",
    itens: ["Bluetooth 5.3 com baixa latência", "Estojos de recarga compactos", "Excelente resposta de graves"]
  },
  {
    titulo: "Suportes Veiculares & Para Mesa",
    descricao: "Suportes veiculares magnéticos MagSafe e de trava por gravidade para ar-condicionado e painel. Suportes articulados de metal para home office.",
    mensagem: "Olá, gostaria de ver os suportes veiculares e de mesa disponíveis",
    destaque: "Conveniência",
    itens: ["Fixação firme sem trepidação", "Giro 360 graus", "Compatível com todos os celulares"]
  },
  {
    titulo: "Cartões de Memória & Pen Drives",
    descricao: "Armazenamento confiável SanDisk e Kingston classe 10 para expansão de memória de celulares, câmeras e notebooks, com velocidade de leitura rápida.",
    mensagem: "Olá, gostaria de verificar opções de pen drive e cartão de memória disponíveis",
    destaque: "Armazenamento",
    itens: ["Capacidades de 32GB a 256GB", "Alta velocidade de transferência", "Garantia contra defeito"]
  }
];
---

<Layout 
  title="Loja de Acessórios para Celular e Computador em Passos | HDM Infocell"
  description="Cabos, carregadores turbo, películas, capinhas, periféricos e fones em Passos - MG. Consulte modelos disponíveis e retire na loja ou receba via WhatsApp."
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Cabeçalho */}
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-amber-400 uppercase tracking-wider mb-2">
        <a href="/" class="hover:underline text-gray-400">Início</a>
        <span class="text-gray-600">/</span>
        <span>Acessórios & Varejo</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Acessórios & Periféricos
      </h1>
      <p class="text-base sm:text-lg text-gray-300 mt-4 leading-relaxed">
        Produtos selecionados para o seu smartphone e computador em Passos - MG. Consulte a disponibilidade do modelo exato do seu aparelho pelo WhatsApp.
      </p>
    </div>

    {/* Grid Bento de Produtos */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categorias.map((cat) => (
        <div class="rounded-3xl bg-white/[0.04] backdrop-blur-md border border-white/10 p-7 flex flex-col justify-between hover:border-amber-500/40 hover:bg-white/[0.06] transition-all group">
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-semibold text-[#FACC15] bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
                {cat.destaque}
              </span>
              <span class="text-xs text-gray-400">Pronta Entrega</span>
            </div>

            <h2 class="font-display text-xl font-bold text-white mb-2 group-hover:text-[#FACC15] transition-colors">
              {cat.titulo}
            </h2>

            <p class="text-sm text-gray-300 mb-6 leading-relaxed">
              {cat.descricao}
            </p>

            <ul class="space-y-2 mb-8 text-xs text-gray-400">
              {cat.itens.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FACC15]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Botão com WhatsApp URL-encoded */}
          <a
            href={`https://wa.me/5535999820832?text=${encodeURIComponent(cat.mensagem)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[48px] px-5 py-3 rounded-xl bg-white/5 hover:bg-[#FACC15] hover:text-black text-white font-semibold text-sm border border-white/10 active:scale-[0.98] transition-all flex items-center justify-between shadow-sm"
            aria-label={`Consultar modelos de ${cat.titulo} no WhatsApp`}
          >
            <span>Ver Disponibilidade</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    {/* Banner Informativo sobre aplicação na loja */}
    <div class="mt-16 p-8 rounded-3xl bg-amber-500/5 border border-amber-500/20 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <h3 class="font-display text-lg font-bold text-white">Aplicação Gratuita de Películas na Loja</h3>
        <p class="text-sm text-gray-400">Comprando sua película na HDM Infocell, a aplicação sem bolhas e alinhamento milimétrico é por nossa conta.</p>
      </div>
      <a
        href="https://wa.me/5535999820832?text=Ol%C3%A1%2C%20gostaria%20de%20saber%20o%20endere%C3%A7o%20para%20aplicar%20uma%20pel%C3%ADcula%20na%20loja"
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[48px] px-6 py-3 rounded-xl bg-[#FACC15] text-black font-bold text-sm hover:bg-yellow-400 whitespace-nowrap transition-all shadow-md shadow-yellow-500/10"
      >
        <span>Ver Como Chegar</span>
      </a>
    </div>

  </div>
</Layout>
