---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página não encontrada | HDM Informática">
  <section class="min-h-[80vh] flex flex-col items-center justify-center text-center px-4 relative z-10">
    <h1 class="text-9xl font-display font-bold text-yellow-500 opacity-20 mb-4 tracking-tighter">404</h1>
    <h2 class="text-3xl md:text-4xl font-light text-white mb-6">Página não encontrada</h2>
    <p class="text-gray-400 max-w-md mx-auto mb-10 leading-relaxed">
      A página que você está procurando pode ter sido removida, mudou de nome ou está temporariamente indisponível.
    </p>
    <a href="/" class="min-h-[48px] px-8 py-3.5 rounded-xl bg-[#FACC15] text-black font-bold text-base hover:bg-yellow-400 active:scale-[0.98] transition-all inline-flex items-center gap-2 shadow-xl shadow-yellow-500/20" aria-label="Voltar para a página inicial">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Voltar para o Início
    </a>
  </section>
</Layout>
